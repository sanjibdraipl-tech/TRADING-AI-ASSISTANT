# GEMINI_API_KEY: Required for Gemini AI API calls (SERVER-ONLY — never use VITE_ prefix).
# AI Studio automatically injects this at runtime from user secrets.
# For local development, copy this file to .env.local (ignored by git) and set your key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Default server-side Gemini text/voice model.
GEMINI_MODEL="gemini-4-hydrogen"

# GEMINI_TIMEOUT_MS: Server-side AbortController timeout per upstream attempt (ms).
GEMINI_TIMEOUT_MS=30000

# GEMINI_RETRY_COUNT: Controlled retries for transient network/5xx/timeout errors.
GEMINI_RETRY_COUNT=1

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
